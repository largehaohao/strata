diff --git a/src/split/src/moe_down_direct.cuh b/src/split/src/moe_down_direct.cuh
new file mode 100644
index 00000000..e5489196
--- /dev/null
+++ b/src/split/src/moe_down_direct.cuh
@@ -0,0 +1,74 @@
+// Read precomputed routed activations directly from their device buffer.
+// Keep the original two 16-value integer dot products and float sum order.
+#pragma once
+
+template <ggml_type TA> struct DownDot32 {
+    int lo[4], hi[4];
+    float d;
+    __device__ __forceinline__ DownDot32(const char* row, int b) {
+        static_assert(TA == GGML_TYPE_IQ4_NL || TA == GGML_TYPE_Q4_0, "down reuse type");
+        static_assert(sizeof(block_iq4_nl) == sizeof(block_q4_0), "shared down block layout");
+        using Block = std::conditional_t<TA == GGML_TYPE_IQ4_NL, block_iq4_nl, block_q4_0>;
+        const Block* w = reinterpret_cast<const Block*>(row) + b;
+        d = __half2float(w->d);
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int q = get_int_b2(w->qs, i);
+            if constexpr (TA == GGML_TYPE_IQ4_NL) {
+                const int2 v = get_int_from_table_16(q, kvalues_iq4nl);
+                lo[i] = v.x;
+                hi[i] = v.y;
+            } else {
+                lo[i] = q & 0x0f0f0f0f;
+                hi[i] = (q >> 4) & 0x0f0f0f0f;
+            }
+        }
+    }
+    __device__ __forceinline__ float dot(const block_q8_1& x) const {
+        float result = 0.f;
+#pragma unroll
+        for (int p = 0; p < 2; ++p) {
+            int sum = 0;
+#pragma unroll
+            for (int l = 0; l < 2; ++l) {
+                const int i = p * 2 + l;
+                sum = ggml_cuda_dp4a(lo[i], get_int_b4(x.qs, i), sum);
+                sum = ggml_cuda_dp4a(hi[i], get_int_b4(x.qs, i + 4), sum);
+            }
+            if constexpr (TA == GGML_TYPE_IQ4_NL) result += (d * __low2float(x.ds)) * sum;
+            else {
+                const float2 ds = __half22float2(x.ds);
+                result += d * (sum * ds.x - 4 * ds.y);
+            }
+        }
+        return result;
+    }
+};
+template <ggml_type TA>
+__global__ void __launch_bounds__(DN_THREADS) k_moe_down_direct(MoeW w, const Job* __restrict__ jobs, const int* __restrict__ njobs,
+                                                        const float* /* precomputed by k_moe_h */, float* __restrict__ out) {
+    const int ji = blockIdx.y;
+    if (ji >= *njobs) return;
+    __shared__ Job jb;
+    extern __shared__ float dn_part[];
+    float(*part)[DN_THREADS] = reinterpret_cast<float(*)[DN_THREADS]>(dn_part);
+    if (threadIdx.x == 0) jb = jobs[ji];
+    __syncthreads();
+    const int ffs = w.ncols, nb = ffs / DN_U, n = jb.n;
+    const int rpb = DN_THREADS / nb, r = threadIdx.x / nb, u = threadIdx.x % nb;
+    const int row = blockIdx.x * rpb + r;
+    const bool live = r < rpb && row < w.nrows;
+    if (live) {
+        const char* wr = moe_expert(w, jb.w) + (size_t) row * w.row_a;
+        const DownDot32<TA> decoded(wr, u);
+        for (int j = 0; j < n; ++j) part[j][threadIdx.x] = decoded.dot(g_moe_hq[jb.y[j]][u]);
+    }
+    __syncthreads();
+    for (int e = threadIdx.x; e < n * rpb; e += DN_THREADS) {
+        const int j = e / rpb, rr = e % rpb, orow = blockIdx.x * rpb + rr;
+        if (orow >= w.nrows) continue;
+        float s = 0.f;
+        for (int k = 0; k < nb; ++k) s += part[j][rr * nb + k];
+        out[(size_t) jb.out[j] * w.nrows + orow] = s;
+    }
+}
