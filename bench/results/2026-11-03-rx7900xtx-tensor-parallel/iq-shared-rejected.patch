 #include "moe_iq_reuse.cuh"
 
+// The shared expert uses extra blocks ahead of IQ jobs, as on the Q4_K path.
+// Its 128-thread blocks use the same per-row sums as dense Q8's 256-thread blocks.
+template <ggml_type TA, int G>
+void gu_iq_shared_launch(int T, const MoeW& w, const Job* jobs, const int* njobs, int njobs_max,
+                         const block_q8_1* y, float* out, cudaStream_t s, const ShexpDown& sd) {
+    const int gx = (w.nrows + MMVQ_THREADS / G - 1) / (MMVQ_THREADS / G);
+    const int blocks = (sd.rows + MMVQ_THREADS / 32 - 1) / (MMVQ_THREADS / 32);
+    const int sd_rows = (blocks + gx - 1) / gx;
+    const dim3 grid(gx, njobs_max + sd_rows);
+#define FNX_IQ_SHARED(t) case t: k_moe_gu_iq<TA, t, G, true><<<grid, MMVQ_THREADS, 0, s>>>(w, jobs, njobs, y, out, sd, sd_rows); break
+    switch (T) {
+        FNX_IQ_SHARED(1); FNX_IQ_SHARED(2); FNX_IQ_SHARED(3); FNX_IQ_SHARED(4);
+        FNX_IQ_SHARED(5); FNX_IQ_SHARED(6); FNX_IQ_SHARED(7); FNX_IQ_SHARED(8);
+        FNX_IQ_SHARED(9); FNX_IQ_SHARED(10); FNX_IQ_SHARED(11); FNX_IQ_SHARED(12);
+        FNX_IQ_SHARED(13); FNX_IQ_SHARED(14); FNX_IQ_SHARED(15); FNX_IQ_SHARED(16);
+        default: throw std::runtime_error("moe IQ shared expert: T out of range");
+    }
+#undef FNX_IQ_SHARED
+}
+
+template <ggml_type TA>
+void gu_iq_shared(int T, const MoeW& w, const Job* jobs, const int* njobs, int njobs_max,
+                  const block_q8_1* y, float* out, cudaStream_t s, const ShexpDown& sd) {
+    const auto group = env_int("FNX_IQ_GROUP", 32);
+    if (group == 16) gu_iq_shared_launch<TA, 16>(T, w, jobs, njobs, njobs_max, y, out, s, sd);
+    else if (group == 32) gu_iq_shared_launch<TA, 32>(T, w, jobs, njobs, njobs_max, y, out, s, sd);
+    else throw std::runtime_error("FNX_IQ_GROUP: expected 16 or 32");
+}
+
+
