# Validated on 2x RX 7900 XTX, HIP, Qwen3.8-Flash-Next UD-IQ2_XS.
# Set STRATA_ROOT to the project checkout before sourcing this file.
# Model flags: --spec 6 --lookup 15 --max-context 262144.
# Effective sampling: temperature 1.0, top_p 0.95, top_k 20.
export FNX_TOPK_EXACT_FAST=2
export FNX_TOPK_PARTS=32
export FNX_DRAFT_SAMPLE_IO=2
export FNX_VERIFY_SAMPLE=1
export FNX_LOOKUP_INDEX=1
export HSA_ENABLE_INTERRUPT=0
export FNX_EXPERT_RAM_GIB=9.75
export FNX_EXPERT_PROFILE="${STRATA_ROOT:?Set STRATA_ROOT to the project checkout}/configs/pi-decode-rx7900xtx/expert-profile.bin"
