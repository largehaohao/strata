# Overrides for the existing Swift 1.5 IQ3_S Pi profile on two RX 7900 XTX GPUs.
# Measured with --spec 6 --lookup 15 --max-context 200768
export FNX_DECODE_TIMING=0
export FNX_EXPERT_PROFILE="${STRATA_ROOT:?Set STRATA_ROOT to the checkout}/configs/pi-decode-rx7900xtx/expert-profile.bin"
export FNX_EXPERT_RAM_GIB=16.25
export FNX_SH_FUSE_IQ=1
export FNX_SKIP_IDLE_EVENTS=1
export FNX_STATIC_CACHE_POOL1_SLOTS=160
