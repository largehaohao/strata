# Overrides for the existing Unsloth UD-IQ3_XXS Pi profile on two RX 7900 XTX GPUs.
# Measured with --spec 6 --lookup 15 --max-context 204800
export FNX_DECODE_TIMING=0
export FNX_EXPERT_PROFILE="${STRATA_ROOT:?Set STRATA_ROOT to the checkout}/configs/pi-decode-rx7900xtx/expert-profile.bin"
export FNX_EXPERT_RAM_GIB=16.5
export FNX_SH_FUSE_IQ=1
export FNX_SKIP_IDLE_EVENTS=1
export FNX_STATIC_CACHE_POOL1_SLOTS=288
export FNX_STATIC_CACHE_SLOTS=1408
